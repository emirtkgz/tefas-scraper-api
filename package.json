{
  "name": "tefas-scraper-api",
  "version": "2.0.0",
  "description": "Unofficial Node.js wrapper for TEFAS API ",
  "homepage": "https://github.com/emirtkgz/tefas-scraper-api#readme",
  "bugs": {
    "url": "https://github.com/emirtkgz/tefas-scraper-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emirtkgz/tefas-scraper-api.git"
  },
  "license": "MIT",
  "author": "emirtkgz",
  "type": "module",
  "main": "./tefas/index.cjs",
  "module": "./tefas/index.js",
  "exports": {
    ".": {
      "import": "./tefas/index.js",
      "require": "./tefas/index.cjs"
    }
  },
  "scripts": {
    "test": "node --test",
    "build": "npx rollup ./tefas/index.js --file ./tefas/index.cjs --format cjs",
    "generate-docs": "jsdoc -c ./jsdocs.json -r"
  },
  "devDependencies": {
    "jsdoc": "^4.0.5"
  }
}
